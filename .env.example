# Copy to .env.local (app) or server/.env (API). Never commit real values.
# The app runs fully on the built-in simulated backend when these are empty.

# ---- App (inlined into the web/iOS bundle at build time: PUBLIC values only) ----
# Hayve API base URL (DigitalOcean App Platform), e.g. https://hayve.app/api
EXPO_PUBLIC_API_URL=
# Mapbox public token (pk.…), restricted to your domains/bundle id in the Mapbox dashboard.
EXPO_PUBLIC_MAPBOX_TOKEN=
# Optional: style published from Mapbox Studio (mapbox://styles/<user>/<id>). Defaults to the built-in Hayve style.
EXPO_PUBLIC_MAPBOX_STYLE_URL=
# Optional fallback for the website only: MapLibre + MapTiler key.
EXPO_PUBLIC_MAPTILER_KEY=

# ---- API (server only, never in the app) ----
DATABASE_URL=postgres://user:password@host:25060/hayve?sslmode=require
DATABASE_CA_CERT=
# 32+ random characters: openssl rand -base64 48
JWT_SECRET=
APP_ORIGINS=http://localhost:8081
# DigitalOcean Spaces (S3 compatible) + CDN. Only URLs are stored in the database.
SPACES_ENDPOINT=https://ams3.digitaloceanspaces.com
SPACES_REGION=ams3
SPACES_BUCKET=hayve-media
SPACES_KEY=
SPACES_SECRET=
SPACES_CDN_URL=https://hayve-media.ams3.cdn.digitaloceanspaces.com
# Transactional email (verification links)
POSTMARK_TOKEN=
EMAIL_FROM=Hayve <no-reply@hayve.app>

# Payment partner (server only): Stripe Terminal (Tap to Pay) + Stripe Issuing (Hayve Card).
# Balances and cards need an e-money licence or a licensed partner (EMI); keys never go in the app.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TERMINAL_LOCATION=
