# Copy to .env.local. Never commit real values.
# The app runs fully on the built-in simulated backend when these are empty.

# Supabase (when the Supabase adapter is enabled, see docs/ARCHITECTURE.md)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Payment provider (server side only — never expose secret keys to the app)
# PAYMENTS_PROVIDER=stripe|adyen|mollie
# PAYMENTS_SECRET_KEY=

# EAS builds (store as a GitHub Actions secret, not here)
# EXPO_TOKEN=
