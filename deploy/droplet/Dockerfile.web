# Hayve website: static Expo web export served by Caddy, which also proxies /api to the API.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci
COPY . .
ARG EXPO_PUBLIC_API_URL=
ARG EXPO_PUBLIC_MAPBOX_TOKEN=
ARG EXPO_PUBLIC_MAPBOX_STYLE_URL=
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL \
    EXPO_PUBLIC_MAPBOX_TOKEN=$EXPO_PUBLIC_MAPBOX_TOKEN \
    EXPO_PUBLIC_MAPBOX_STYLE_URL=$EXPO_PUBLIC_MAPBOX_STYLE_URL \
    NODE_OPTIONS=--max-old-space-size=3072
RUN npx expo export --platform web

FROM caddy:2-alpine
COPY deploy/droplet/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
